root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,cjs,mjs,ts,tsx,css,json,jsonc,yml,yaml}]
indent_size = 2

[{composer.json,composer.lock}]
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
indent_size = 4
