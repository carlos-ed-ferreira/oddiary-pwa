APP_NAME="Oddiary PWA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_PORT=8010
VITE_PORT=5180

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oddiary_pwa
DB_USERNAME=oddiary_pwa
DB_PASSWORD=local-only
DB_SSLMODE=prefer

SESSION_DRIVER=cookie
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
