<?xml version="1.0"?>
<ruleset name="Oddiary PWA" xmlns="http://pmd.sf.net/ruleset/1.0.0">
    <description>Bootstrap maintainability gates</description>
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity"><properties><property name="reportLevel" value="11"/></properties></rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength"><properties><property name="minimum" value="51"/></properties></rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength"><properties><property name="minimum" value="401"/></properties></rule>
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
